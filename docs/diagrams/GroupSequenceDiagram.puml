@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant ":LogicManager" as logic LOGIC_COLOR
participant ":AddressBookParser" as parser LOGIC_COLOR
participant ":GroupCommandParser" as groupParser LOGIC_COLOR
participant "command:GroupCommand" as command LOGIC_COLOR
participant "staged:StagedModel" as staged MODEL_COLOR
participant "live:Model" as live MODEL_COLOR
participant ":StorageManager" as storage STORAGE_COLOR
participant ":UndoSnapshotStorage" as undo STORAGE_COLOR
participant ":CollectionSaveTransaction" as transaction STORAGE_COLOR

[-> logic : execute(group command)
logic -> parser : parseCommand(text)
parser -> groupParser : parse(arguments)
groupParser -> command : create GroupCommand(action, group, name or index)
command --> groupParser : command
groupParser --> parser : command
parser --> logic : command
logic -> staged : new StagedModel(live)
staged -> live : copy collections and displayed list
live --> staged
logic -> command : execute(staged)
alt list or view
    command -> staged : getGroupList() / getGroup(name)
    staged --> command : groups and contacts
    command --> logic : CommandResult with counts or member details
    note over storage : No contact save for read-only commands
    [<-- logic : CommandResult
else create, change membership, or delete
    alt create: group add n/NAME
        command -> staged : addGroup(new Group(name, empty ID set))
    else membership change by name or displayed index
        command -> staged : getGroup(name), getAddressBook(), getFilteredPersonList()
        staged --> command : group and contacts
        command -> command : resolve unique name or displayed index to Person.id
        command -> staged : setGroup(group.withMember/withoutMember(personId))
    else delete: group delete g/NAME
        command -> staged : deleteGroup(name)
    end
    staged --> command
    command --> logic : CommandResult
    logic -> logic : capture previous and candidate ContactSnapshots
    logic -> storage : saveUndoableChange(previous, candidate, description, section)
    storage -> undo : saveChange(...)
    undo -> transaction : save selected collections and undo history
    transaction -> transaction : write temporary JSON; journal originals; atomically replace
    alt save succeeds
        transaction --> undo
        undo --> storage
        storage --> logic
        logic -> staged : commitTo(live)
        staged -> live : replay addGroup / setGroup / deleteGroup
        live --> staged
        [<-- logic : CommandResult
    else save fails
        transaction -> transaction : recover published files if needed
        transaction --> undo : IOException
        undo --> storage : IOException
        storage --> logic : IOException
        note over live : Live groups remain unchanged
        [<-- logic : CommandException
    end
end
@enduml
