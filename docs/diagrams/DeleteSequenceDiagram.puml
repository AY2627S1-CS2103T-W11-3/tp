@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Successful execution of "delete 1"

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "change:PreparedChange" as PreparedChange LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

ref over LogicManager, DeleteCommand
Parse command and capture undo snapshot
end ref

LogicManager -> DeleteCommand : prepare(m)
activate DeleteCommand
DeleteCommand -> Model : getFilteredPersonList()
activate Model
Model --> DeleteCommand : displayed contacts
deactivate Model
DeleteCommand -> Model : getAddressBook()
activate Model
Model --> DeleteCommand : current collection
deactivate Model

note right of DeleteCommand
Validate the displayed index.
Copy the collection and remove the target
from the candidate, leaving m unchanged.
end note

create PreparedChange
DeleteCommand -> PreparedChange : PreparedChange(candidate, ...)
activate PreparedChange
PreparedChange --> DeleteCommand
deactivate PreparedChange
DeleteCommand --> LogicManager : change
deactivate DeleteCommand

' The ref hides PreparedChange.save(), its callback to LogicManager, and Storage calls.
ref over LogicManager, PreparedChange
Save candidate and undo snapshot
end ref

LogicManager -> PreparedChange : apply()
activate PreparedChange
PreparedChange -> Model : deletePerson(target)
activate Model
Model --> PreparedChange
deactivate Model
PreparedChange --> LogicManager : result
deactivate PreparedChange

[<--LogicManager : result
deactivate LogicManager
@enduml
