@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "change:PreparedChange" as PreparedChange LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("delete 1")
LogicManager -> AddressBookParser : parseCommand("delete 1")
AddressBookParser -> DeleteCommandParser : parse("1")
DeleteCommandParser -> DeleteCommand : new DeleteCommand(index)
DeleteCommand --> AddressBookParser : d
AddressBookParser --> LogicManager : d
LogicManager -> DeleteCommand : prepare(m)
DeleteCommand -> Model : getFilteredPersonList()
Model --> DeleteCommand : displayed contacts
DeleteCommand -> Model : getAddressBook()
Model --> DeleteCommand : current collection
DeleteCommand -> PreparedChange : new PreparedChange(candidate, apply)
PreparedChange --> LogicManager : change
LogicManager -> Storage : save candidate collection
alt save succeeds
    Storage --> LogicManager
    LogicManager -> PreparedChange : apply()
    PreparedChange -> Model : deletePerson(target)
    Model --> PreparedChange
    PreparedChange --> LogicManager : CommandResult
    [<-- LogicManager : success
else save fails
    Storage --> LogicManager : IOException
    note over Model : No live-model mutation
    [<-- LogicManager : CommandException
end
@enduml
