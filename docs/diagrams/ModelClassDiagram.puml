@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class StagedModel
Class ContactSnapshot
Class UserPrefs
Class "<<enumeration>>\nContactSection" as ContactSection

Class UniquePersonList
Class "FilteredList<Person>" as FilteredPersonList
Class "SortedList<Person>" as SortedPersonList
Class Person
Class Group
Class Address
Class Email
Class Name
Class Note
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
StagedModel .up.|> Model
StagedModel *--> "1 candidate" ModelManager
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager *-left-> "2\nContacts, Favourites" AddressBook : addressBooks
ModelManager -right-> "1" UserPrefs
ModelManager --> "1" ContactSection : activeSection
ContactSnapshot *--> "2\nContacts, Favourites" AddressBook
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
AddressBook *--> "*" Group : groups
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> Note
Person *--> "*" Tag
Group ..> Person : member IDs match Person.id
note on link : Group.members is Set<UUID>; Person.id is UUID

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "1" FilteredPersonList : filteredPersons
ModelManager --> "1" SortedPersonList : displayedPersons
FilteredPersonList --> "~* source" Person
SortedPersonList --> "1 source" FilteredPersonList
@enduml
