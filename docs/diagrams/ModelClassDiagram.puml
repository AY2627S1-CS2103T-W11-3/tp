@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class StagedModel
enum ContactSection {
    CONTACTS
    FAVOURITES
}
show ContactSection members
Class UserPrefs

Class UniquePersonList
Class Person
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
StagedModel .up.|> Model
StagedModel *--> "1" ModelManager : candidate
StagedModel --> "0..1" ContactSection : changedSection
ModelManager --> "1" ContactSection : activeSection
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "2" AddressBook : addressBooks\nkeyed by ContactSection
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> "*" Tag

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "~* filtered" Person
note bottom of StagedModel
Copies both collections and the active view.
Records operations for one changed section.
Replays them only after saving succeeds.
end note
note bottom of ModelManager
Contacts and Favourites are independent.
Each retains its filter and display order.
The observable active view is unmodifiable.
User preferences are shared.
end note
@enduml
