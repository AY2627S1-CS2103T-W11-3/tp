@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Save restored snapshot

box Logic LOGIC_COLOR_T1
participant "change:PreparedChange" as PreparedChange LOGIC_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "history:StorageManager" as History STORAGE_COLOR
participant "sharedHistory:UndoSnapshotStorage" as Snapshots STORAGE_COLOR
participant "transaction:CollectionSaveTransaction" as Transaction STORAGE_COLOR
end box

[-> PreparedChange : save(...)
activate PreparedChange
PreparedChange -> History : saveRestoredSnapshot(snapshot)
activate History
History -> Snapshots : saveRestoredSnapshot(snapshot)
activate Snapshots

Snapshots -> Transaction : save(contacts, favourites, remainingHistory, ...)
activate Transaction
ref over Transaction
Save selected collections and shared history
with rollback and interrupted-save recovery
end ref
Transaction --> Snapshots
deactivate Transaction
Snapshots --> History
deactivate Snapshots
History --> PreparedChange
deactivate History
[<--PreparedChange
deactivate PreparedChange

note over PreparedChange, History
The undo logic applies the restoration and consumes history
only after this save succeeds.
end note
@enduml
