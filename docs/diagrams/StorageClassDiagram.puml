@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "AddressBook Storage" #F4F6F6{
Class JsonAddressBookStorage
Class JsonSerializableAddressBook
Class JsonAdaptedPerson
Class JsonAdaptedTag
}

package "Undo Storage" #F4F6F6{
Class UndoSnapshotStorage
Class JsonUndoHistory
}

}

package Model {
Class "<<interface>>\nUndoHistory" as UndoHistory MODEL_COLOR
Class "<<enum>>\nContactSection" as ContactSection MODEL_COLOR
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
Storage -up-|> UndoHistory
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "2" JsonAddressBookStorage : Contacts and Favourites
StorageManager *-down-> "2" UndoSnapshotStorage : undoHistories\nkeyed by ContactSection
StorageManager ..> ContactSection : history keys
UndoSnapshotStorage --> "1" JsonAddressBookStorage : section data and snapshots
UndoSnapshotStorage ..> JsonUndoHistory : <<create/read>>
JsonUndoHistory --> "0..1" JsonUndoHistory : previous

JsonAddressBookStorage ..> JsonSerializableAddressBook
JsonSerializableAddressBook --> "*" JsonAdaptedPerson
JsonAdaptedPerson --> "*" JsonAdaptedTag

note bottom of UndoSnapshotStorage
Up to five snapshots per section.
Validated history survives restarts.
end note

@enduml
