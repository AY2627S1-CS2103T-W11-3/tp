@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command
Class XYZCommand
Class DeleteCommand
Class FavouriteCommand
Class UndoCommand

package "Parser classes" as ParserClasses {
Class "<<interface>>\nParser" as Parser
Class AddressBookParser
Class XYZCommandParser
Class DeleteCommandParser
Class FavouriteCommandParser
Class UndoCommandParser
Class CliSyntax
Class ParserUtil
Class ArgumentMultimap
Class ArgumentTokenizer
Class Prefix
}

package Model {
Class "<<interface>>\nUndoHistory" as UndoHistory MODEL_COLOR
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> AddressBookParser

AddressBookParser .down.> XYZCommandParser: <<create>>

XYZCommandParser ..> XYZCommand : <<create>>
AddressBookParser ..> Command : <<use>>
XYZCommandParser .up.|> Parser
XYZCommandParser ..> ArgumentMultimap
XYZCommandParser ..> ArgumentTokenizer
ArgumentTokenizer .left.> ArgumentMultimap
XYZCommandParser ..> CliSyntax
CliSyntax ..> Prefix
XYZCommandParser ..> ParserUtil
ParserUtil .down.> Prefix
ArgumentTokenizer .down.> Prefix
XYZCommand -up-|> Command
' Command-specific inheritance is shown in LogicClassDiagram.

AddressBookParser .down.> DeleteCommandParser : <<create>>
AddressBookParser .down.> FavouriteCommandParser : <<create>>
AddressBookParser .down.> UndoCommandParser : <<create>>
DeleteCommandParser .up.|> Parser
FavouriteCommandParser .up.|> Parser
UndoCommandParser .up.|> Parser
DeleteCommandParser .down.> DeleteCommand : <<create>>
FavouriteCommandParser .down.> FavouriteCommand : <<create>>
UndoCommandParser .down.> UndoCommand : <<create>>
DeleteCommandParser ..> ParserUtil
FavouriteCommandParser ..> ParserUtil
AddressBookParser --> "1" UndoHistory
UndoCommandParser --> "1" UndoHistory
@enduml
