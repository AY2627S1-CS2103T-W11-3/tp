@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Component interactions for a successful "delete 1"

actor User as user USER_COLOR
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : "delete 1"
activate ui
ui -> logic : execute("delete 1")
activate logic

ref over logic, model
Prepare both candidate collections and shared undo history
end ref

logic -> storage : saveUndoableChange(...)
activate storage
storage --> logic
deactivate storage

logic -> model : deletePerson(target)
activate model
model --> logic
deactivate model

logic --> ui : result
deactivate logic
ui --> user : success feedback
deactivate ui
@enduml
