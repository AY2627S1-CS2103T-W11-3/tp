@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

package "Parser Classes" as ParserClasses{
}
Class XYZCommand
Class CommandResult
Class "{abstract}\nCommand" as Command
Class "{abstract}\nUndoableCommand" as UndoableCommand
Class DeleteCommand
Class FavouriteCommand
Class UndoCommand
Class "<<interface>>\nStagedCommand" as StagedCommand
Class PreparedChange


Class "<<interface>>\nLogic" as Logic
Class LogicManager
}

package Model {
Class HiddenModel #FFFFFF
}

package Storage {
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager .right.|> Logic
LogicManager -right->"1" ParserClasses
ParserClasses ..> XYZCommand : <<create>>

XYZCommand -up-|> Command
UndoableCommand -up-|> Command
DeleteCommand -up-|> UndoableCommand
FavouriteCommand -up-|> UndoableCommand
UndoCommand -up-|> Command
DeleteCommand .down.|> StagedCommand
UndoCommand .down.|> StagedCommand
StagedCommand ..> PreparedChange : <<return>>
LogicManager .left.> Command : <<call>>
LogicManager ..> StagedCommand : <<prepare>>

LogicManager --> Model
LogicManager --> Storage
Storage --[hidden] Model
Command .[hidden]up.> Storage
Command .right.> Model
note right of XYZCommand: XYZCommand = AddCommand, \nFindCommand, etc

Logic ..> CommandResult
LogicManager .down.> CommandResult
Command .up.> CommandResult : <<create>>
note bottom of PreparedChange
Candidate data and the operation
to publish after saving.
end note
@enduml
